{
  "name": "worktrack-client-portal",
  "version": "1.0.1",
  "description": "WorkTrack Client Portal - Customer interface for tracking and management",
  "author": {
    "name": "WorkTrack Team",
    "email": "contact@worktrack.com"
  },
  "homepage": "https://github.com/worktrack/worktrack-client",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:version": "npm version patch && npm run build",
    "build:electron": "ELECTRON=true vite build",
    "preview": "vite preview",
    "electron": "ELECTRON=true electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3002 && ELECTRON=true electron .\"",
    "build:electron:app": "npm run build:electron && electron-builder",
    "build:electron:win": "npm run build:electron && electron-builder --win",
    "build:electron:win:portable": "npm run build:electron && electron-builder --win --publish never --config.win.target=portable",
    "build:electron:mac": "npm run build:electron && electron-builder --mac",
    "build:electron:linux": "npm run build:electron && electron-builder --linux",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:build:ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "axios": "^1.18.1",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "vite": "^5.3.1",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.worktrack.client",
    "productName": "WorkTrack Client",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Office",
      "maintainer": "WorkTrack Team <contact@worktrack.com>",
      "executableName": "worktrack-client"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico"
    }
  }
}
